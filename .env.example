# Alpaca paper trading only. Never put live keys in this learning app.
ALPACA_PAPER_ONLY=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY_ID=replace_me
ALPACA_API_SECRET_KEY=replace_me

